{
    "accessibility.dimUnfocused.enabled": true,
    "accessibility.dimUnfocused.opacity": 0.6,
    "editor.acceptSuggestionOnEnter": "on",
    "editor.accessibilitySupport": "off",
    "editor.allowVariableFonts": false,
    "editor.allowVariableLineHeights": false,
    "editor.autoIndentOnPasteWithinString": false,
    "editor.bracketPairColorization.enabled": false,
    "editor.codeActionWidget.includeNearbyQuickFixes": false,
    "editor.codeActionWidget.showHeaders": false,
    "editor.codeLens": false,
    "editor.colorDecorators": false,
    "editor.copyWithSyntaxHighlighting": false,
    "editor.cursorBlinking": "solid",
    "editor.cursorWidth": 3,
    "editor.defaultColorDecorators": "never",
    "editor.detectIndentation": false,
    "editor.dragAndDrop": false,
    "editor.dropIntoEditor.enabled": false,
    "editor.emptySelectionClipboard": false,
    "editor.find.addExtraSpaceOnTop": false,
    "editor.folding": false,
    "editor.fontSize": 15,
    "editor.fontWeight": "normal",
    "editor.formatOnSave": true,
    "editor.glyphMargin": false,
    "editor.inlayHints.enabled": "off",
    "editor.letterSpacing": 1,
    "editor.lineHeight": 0,
    "editor.lightbulb.enabled": "off",
    "editor.matchBrackets": "never",
    "editor.minimap.enabled": false,
    "editor.overviewRulerBorder": false,
    "editor.parameterHints.enabled": false,
    "editor.renderControlCharacters": true,
    "editor.renderLineHighlight": "none",
    "editor.renderWhitespace": "none",
    "editor.roundedSelection": false,
    "editor.scrollbar.horizontal": "visible",
    "editor.scrollbar.horizontalScrollbarSize": 6,
    "editor.scrollbar.vertical": "visible",
    "editor.scrollbar.verticalScrollbarSize": 6,
    "editor.showFoldingControls": "never",
    "editor.showUnused": false,
    "editor.snippets.codeActions.enabled": false,
    "editor.snippetSuggestions": "none",
    "editor.stickyScroll.enabled": false,
    "editor.stickyTabStops": true,
    "editor.suggest.insertMode": "insert",
    "editor.suggest.showClasses": true,
    "editor.unicodeHighlight.includeStrings": false,
    "scm.alwaysShowActions": true,
    "security.workspace.trust.enabled": false,
    "onboarding.enabled": false,
    "window.density.editorTabHeight": "compact",
    "workbench.activityBar.autoHide": false,
    "workbench.activityBar.compact": true,
    "workbench.editor.decorations.badges": false,
    "workbench.editor.decorations.colors": false,
    "workbench.editor.editorActionsLocation": "hidden",
    "workbench.editor.labelFormat": "default",
    "workbench.editor.pinnedTabSizing": "normal",
    "workbench.editor.showIcons": false,
    "workbench.editor.showTabs": "none",
    "workbench.enableExperiments": false,
    "workbench.externalBrowser": "/usr/bin/google-chrome",
    "workbench.layoutControl.enabled": false,
    "workbench.list.fastScrollSensitivity": 5,
    "workbench.localHistory.enabled": false,
    "workbench.navigationControl.enabled": false,
    "workbench.notifications.showInTitleBar": false,
    "workbench.panel.showLabels": false,
    "workbench.remoteIndicator.showExtensionRecommendations": false,
    "workbench.sash.size": 4,
    "workbench.secondarySideBar.defaultVisibility": "hidden",
    "workbench.settings.editor": "json",
    "workbench.settings.showAISearchToggle": false,
    "workbench.shadows": false,
    "workbench.tips.enabled": false,
    "workbench.tree.indent": 8,
    "workbench.tree.renderIndentGuides": "onHover",
    "workbench.tree.stickyScrollMaxItemCount": 1,
    "workbench.welcomePage.walkthroughs.openOnInstall": false,
    "workbench.iconTheme": "vs-minimal",
    "window.commandCenter": false,
    "window.controlsStyle": "custom",
    "window.customMenuBarAltFocus": false,
    "window.newWindowDimensions": "maximized",
    "window.menuBarVisibility": "compact",
    "window.title": " ",
    "window.titleBarStyle": "custom",
    "files.autoSave": "onFocusChange",
    "files.eol": "\n",
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
        "**/.venv": false,
        "**/.python-version": true,
        "**/uv.lock": true,
        "**/__pycache__": true,
        "**/*.pyc": true,
        "**/.pytest_cache": true
    },
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,
    "files.trimTrailingWhitespace": true,
    "files.trimTrailingWhitespaceInRegexAndStrings": false,
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/.hg/store/**": true,
        "**/__pycache__/**": true,
        "**/.venv/**": true,
        "**/venv/**": true,
        "**/data/**": true
    },
    "explorer.autoOpenDroppedFile": false,
    "explorer.autoRevealExclude": {
        "**/node_modules": true,
        "**/.venv": true,
        "**/venv": true
    },
    "explorer.compactFolders": false,
    "explorer.confirmDragAndDrop": false,
    "explorer.decorations.badges": true,
    "explorer.decorations.colors": true,
    "explorer.enableDragAndDrop": true,
    "explorer.excludeGitIgnore": false,
    "search.actionsPosition": "right",
    "search.decorations.badges": false,
    "search.decorations.colors": false,
    "search.exclude": {
        "**/node_modules": true,
        "**/bower_components": true,
        "**/*.code-search": true,
        "**/.venv": true,
        "**/__pycache__": true
    },
    "search.useGlobalIgnoreFiles": true,
    "search.useIgnoreFiles": true,
    "update.mode": "none",
    "update.showReleaseNotes": true,
    "update.titleBar": false,
    "json.validate.enable": true,
    "markdown.validate.duplicateLinkDefinitions.enabled": "warning",
    "workbench.sideBar.location": "right",
    "terminal.integrated.fontSize": 15,
    "terminal.integrated.tabs.showActions": "never",
    "terminal.integrated.tabs.showActiveTerminal": "singleTerminalOrNarrow",
    "terminal.integrated.drawBoldTextInBrightColors": false,
    "terminal.integrated.showExitAlert": false,
    "terminal.integrated.tabs.enabled": false,
    "terminal.integrated.borderWidth": 0,
    "terminal.integrated.silentNotification": true,
    "terminal.integrated.cursorStyle": "block",
    "terminal.integrated.cursorBlinking": false,
    "terminal.integrated.fontWeight": "normal",
    "terminal.integrated.persistentSessionReviveProcess": "never",
    "terminal.integrated.shellIntegration.decorationsEnabled": "never",
    "breadcrumbs.enabled": false,
    "telemetry.telemetryLevel": "off",
    "telemetry.feedback.enabled": false,
    "outline.icons": false,
    "notebook.formatOnSave.enabled": true,
    "diffEditor.ignoreTrimWhitespace": true,
    "python.defaultInterpreterPath": ".venv/bin/python",
    "python.terminal.activateEnvInSelectedTerminal": true,
    "python.terminal.executeInFileDir": true,
    "python.analysis.typeCheckingMode": "basic",
    "python.analysis.autoImportCompletions": false,
    "python.analysis.diagnosticPublishDelay": 1000,
    "python-envs.defaultEnvManager": "ms-python.python:venv",
    "ruff.lint.select": [
        "E",
        "W",
        "F",
        "I",
        "B",
        "C4",
        "UP",
        "RUF"
    ],
    "ruff.lint.ignore": [
        "B008"
    ],
    "ruff.lineLength": 100,
    "ruff.exclude": [
        ".git",
        ".venv",
        "__pycache__",
        "build",
        "dist"
    ],
    "ruff.format.quoteStyle": "double",
    "ruff.format.indentStyle": "space",
    "ruff.lint.isort.combineAsImports": true,
    "ruff.lint.isort.linesAfterImports": 2,
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit",
            "source.fixAll": "explicit"
        },
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.rulers": [
            100
        ],
        "editor.wordBasedSuggestions": "off"
    },
    "chat.titleBar.signIn.enabled": false
}
